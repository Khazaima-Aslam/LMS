# Branding
NEXT_PUBLIC_APP_NAME=LeadFlow

# Portal login (required in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
AUTH_SECRET=replace-with-a-long-random-secret

# Apify
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxx
APIFY_ACTOR_ID=compass/crawler-google-places

# Google Sheets
GOOGLE_SPREADSHEET_ID=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit
GOOGLE_SHEET_TAB=Leads

# Recommended on Vercel: base64-encode the complete service-account JSON.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Iiw...
# Alternative supported value:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Optional label for server-side OpenStreetMap geocoding requests
GEOCODER_USER_AGENT=LeadFlow/1.0
