# Branding
NEXT_PUBLIC_APP_NAME=LeadFlow

# Master portal administrator
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# Keep this stable. It signs sessions and encrypts each user's saved connection profile.
AUTH_SECRET=replace-with-a-long-random-secret

# LeadFlow INTERNAL system storage only (not any user's lead destination Sheet).
SYSTEM_GOOGLE_SPREADSHEET_ID=https://docs.google.com/spreadsheets/d/YOUR_SYSTEM_SHEET_ID/edit
SYSTEM_GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Iiw...

# Backward compatibility: old GOOGLE_* names are accepted if SYSTEM_* are absent.

# Optional label for server-side geocoding requests.
GEOCODER_USER_AGENT=LeadFlow/1.0
